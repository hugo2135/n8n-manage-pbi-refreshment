營\n            allGreen = false; \n        }\n    }\n    \n    // 🛡️ 階段 B：解析成功後，才開始嚴格的狀態比對\n    if (allGreen && preList && Array.isArray(preList)) {\n         for (const pre of preList) {\n             const preWorkspace = pre.PRE_WORKSPACE_ID;\n             const preDataset = pre.PRE_DATAFLOW_ID;\n             \n             // 精準使用雙層字典抓取狀態\n             const preStatus = statusDict[preWorkspace] ? statusDict[preWorkspace][preDataset] : undefined;\n             \n             // 只要前置任務狀態不是 Success，就扣留本任務\n             if (preStatus !== 'Success') {\n                 allGreen = false; \n                 break; \n             }\n         }\n    }\n    \n    // 3. 綠燈發車：只有格式正確且前置全做完的，才能拿到 Token 準備啟動\n    if (allGreen) {\n         task.TOKEN = currentToken; \n         readyToRun.push({ json: task });\n    }\n});\n\n// 4. 防空包彈：避免空陣列導致 n8n 迴圈斷氣\nif (readyToRun.length === 0) {\n    return [{ json: {} }];\n}\n\nreturn readyToRun;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[2016,1360],"id":"b22d9d16-34c5-48d5-87cc-c66de3bf62ae","name":"整理所有前置"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"f9787d38-87d1-45fd-955d-b555f80c2ba6","leftValue":"={{ $json }}","rightValue":0,"operator":{"type":"object","operation":"notEmpty","singleValue":true}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.3,"position":[2208,1360],"id":"1f527015-cd5a-415a-8a30-3d6a35df0f6c","name":"判斷前置都完成或是沒有前置"},{"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"leftValue":"={{ $json.TYPE }}","rightValue":"Dataflow","operator":{"type":"string","operation":"equals"},"id":"fb4d02a3-97c4-49b3-ac3c-a9fc6af9c808"}],"combinator":"and"},"renameOutput":true,"outputKey":"Dataflow"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"condit