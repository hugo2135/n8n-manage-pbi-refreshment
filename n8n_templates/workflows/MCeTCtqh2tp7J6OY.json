 = task.DATASET_NAME || `未命名任務_${index}`;\n    \n    // 1. 核心必填欄位檢查\n    if (!task.WORKSPACE_ID) errors.push(`[${taskName}] 缺少 WORKSPACE_ID`);\n    if (!task.DATASET_ID) errors.push(`[${taskName}] 缺少 DATASET_ID`);\n    if (task.TYPE !== 'Dataflow' && task.TYPE !== 'Model') {\n        errors.push(`[${taskName}] TYPE 必須是 Dataflow 或 Model，當前為: ${task.TYPE}`);\n    }\n    \n    // 2. 前置清單 (PRE_WORKFLOW_LIST) 格式嚴格檢驗\n    let preList = task.PRE_WORKFLOW_LIST;\n    if (preList && typeof preList === 'string' && preList.trim() !== '') {\n        try {\n            // 測試 A：先嘗試常規標準解析\n            JSON.parse(preList);\n        } catch (e1) {\n            try {\n                // 測試 B：常規失敗，嘗試用我們的「正規表達式」後包裝修復\n                let fixedString = preList.replace(/:\\s*([a-zA-Z0-9\\-]{10,})/g, ':\"$1\"');\n                JSON.parse(fixedString);\n            } catch (e2) {\n                // 🚨 測試 C：連後包裝都救不回來，判定為無效格式！\n                errors.push(`[${taskName}] 的 PRE_WORKFLOW_LIST 格式嚴重錯誤，無法解析。`);\n            }\n        }\n    }\n});\n\n// 3. 結算：只要有 1 個以上的錯誤，直接丟出 Error 中斷整個 n8n 流程！\nif (errors.length > 0) {\n    throw new Error(\"🛑 啟動前安檢失敗，請檢查資料庫或設定：\\n\" + errors.join(\"\\n\"));\n}\n\n// 4. 安檢全數通過，原封不動將資料往後傳，準備進入大迴圈\nreturn $input.all();"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[288,1024],"id":"59090919-bcb9-4da0-82ad-ac492aed9c79","name":"檢驗所有輸入"},{"parameters":{"operation":"get","dataTableId":{"__rl":true,"value":"Of0L0qFUGnuoSwy7","mode":"list","cachedResultName":"Today BI update status","cachedResultUrl":"/projects/j2XBSHZTEc6WCvuW/datatables/Of0L0qFUGnuoSwy7"},"returnAll":true},"type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[80,1024],"id":"70ebd06d-b33c-4017-a848-9c2398805b49","name":"獲取所有已登錄資料流程和語意模型1"},{"parameters":{"keep":"lastItems"},"type":"n8n-nodes-base.limit","typeVersion":1,"position":[2016,1600],"id":"1b6b3a64-77b0-4b54-8c1b-88b598566079","name":"限制觸發"},{"parameters":{"assignments":{"assignments":[{"id":"aba34b42-182f-43b4-af05-396c