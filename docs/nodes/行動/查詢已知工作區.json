{"updatedAt":"2026-07-21T04:05:38.481Z","createdAt":"2026-07-21T04:01:50.914Z","id":"Tthg2gb7mcENQDBy","name":"行動:查詢已知工作區","description":null,"active":false,"isArchived":false,"nodes":[{"parameters":{"workflowInputs":{"values":[{"name":"HelloWorld"}]}},"type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1.1,"position":[0,0],"id":"66f290bf-130a-43c6-a339-dacb8568c058","name":"When Executed by Another Workflow"},{"parameters":{"operation":"get","dataTableId":{"__rl":true,"value":"bEtMKsf5xFjUIy8G","mode":"list","cachedResultName":"Power BI workspaces","cachedResultUrl":"/projects/j2XBSHZTEc6WCvuW/datatables/bEtMKsf5xFjUIy8G"},"returnAll":true},"type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[208,0],"id":"ecab880a-5434-45ed-92f5-5bfd68a89e25","name":"查詢全工作區"},{"parameters":{"jsCode":"// 1. 取得前一個節點回傳的所有資料陣列\nconst dataflows = $input.all();\n\n// 2. 建立一個空的物件(字典)來存放結果\nconst result = {};\n\n// 3. 針對陣列中的每一筆資料進行處理\nfor (const item of dataflows) {\n  // 🚨 關鍵修正：在 n8n 中讀取欄位，中間一定要加 .json\n  const name = item.json.WORKSPACE_NAME;\n  const id = item.json.WORKSPACE_ID;\n  \n  // 將 name 當作鍵 (Key)，objectId 當作值 (Value) 寫入\n  if (name && id) {\n      result[name] = id;\n  }\n}\n\n// 4. 回傳 n8n 看得懂的格式\nreturn [{ json: result }];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[416,0],"id":"753dff97-d96b-42d2-85c7-c1cf9896458d","name":"輸出"}],"connections":{"When Executed by Another Workflow":{"main":[[{"node":"查詢全工作區","type":"main","index":0}]]},"查詢全工作區":{"main":[[{"node":"輸出","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","binaryMode":"separate"},"staticData":null,"meta":null,"pinData":{},"versionId":"d790846d-23b9-4e94-bc1d-50af252643dc","activeVersionId":null,"versionCounter":10,"triggerCount":0,"tags":[{"updatedAt":"2026-07-21T02:47:13.060Z","createdAt":"2026-07-21T02:47:13.060Z","id":"fqovVJIT2YbK7ykL","name":"行動"}],"shared":[{"updatedAt":"2026-07-21T12:53:02.591Z","createdAt":"2026-07-21T12:53:02.591Z","role":"workflow:owner","workf