      "parameters": {
        "jsCode": "// 把所有 workspace 收成以 WORKSPACE_NAME 為 key 的物件\nconst result = {};\nfor (const item of $input.all()) {\n  const ws = item.json;\n  result[ws.WORKSPACE_NAME] = ws;\n}\n\nreturn [{ json: { workspaces: result } }];"
      },
