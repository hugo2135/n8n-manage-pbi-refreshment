    {
      "parameters": {
        "jsCode": "// 模式：Run Once for All Items\n// 取得當前這一圈的 workspace（從 Loop 來源帶過來）\nconst loopItem = $('Loop Over Items').item.json;\n\n// 兩個並行子流程各自的回傳（本圈資料）\nconst 資料流程 = $(\"Call '獲取:所有資料流程'\").all().map(i => i.json);\nconst 語意模型 = $(\"Call '獲取:所有語意模型'\").all().map(i => i.json);\n\nreturn [{\n  json: {\n    WORKSPACE_ID: loopItem.WORKSPACE_ID,\n    WORKSPACE_NAME: loopItem.WORKSPACE_NAME,\n    資料流程,\n    語意模型,\n  }\n}];"
      },
